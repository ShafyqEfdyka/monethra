<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.Monethra" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:forceDarkAllowed" tools:targetApi="29">false</item>
    </style>

    <!-- Android 12+ Core SplashScreen Theme -->
    <style name="Theme.Monethra.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#EAE6F8</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_moth_padded</item>
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">#EAE6F8</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="31">@drawable/ic_splash_moth_padded</item>
        <item name="postSplashScreenTheme">@style/Theme.Monethra</item>
    </style>
</resources>
